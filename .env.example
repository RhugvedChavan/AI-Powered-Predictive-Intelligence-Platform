# ==============================================================================
# Intelligent Data Analytics & Predictive Intelligence Platform - Environment Config
# ==============================================================================

# Application & API Settings
PROJECT_NAME="Intelligent Data Analytics & Predictive Intelligence Platform"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage & Database
# By default, SQLite stores metadata in storage/platform.db and DuckDB runs in-memory / storage/duckdb/
SQLITE_DB_PATH="storage/platform.db"
MAX_UPLOAD_SIZE_MB=150
QUERY_TIMEOUT_SECONDS=30

# AI / LLM Configuration Layer (Optional)
# Supported values: "none" (default deterministic parser), "gemini", "openai", "ollama"
# The platform remains fully functional for data cleaning, EDA, ML, BI, and reporting even with LLM_PROVIDER="none".
LLM_PROVIDER="none"

# Provider-Specific API Keys (Only required if LLM_PROVIDER is set to the respective provider)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Local Ollama Settings (Only required if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Server Port Settings (for Docker or custom deployments)
BACKEND_PORT=8000
FRONTEND_PORT=5173

